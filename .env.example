# Copy to .env and fill in the empty values. Never commit .env.
# Values are as seen from your machine (design E9). docker-compose overrides the
# container-network addresses (host.docker.internal, service names) itself.

# --- App DB (users, history) ---
APP_DB_NAME=querymind
APP_DB_USER=
APP_DB_PASSWORD=

# --- Target DB (Northwind, read-only access) ---
TARGET_DB_HOST=127.0.0.1
TARGET_DB_PORT=5433
TARGET_DB_NAME=northwind
TARGET_DB_OWNER_PASSWORD=
TARGET_DB_RO_USER=querymind_ro
TARGET_DB_RO_PASSWORD=

# --- Auth ---
JWT_SIGNING_KEY=          # at least 32 bytes
JWT_ISSUER=querymind
JWT_AUDIENCE=querymind
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Engine trust ---
ENGINE_INTERNAL_KEY=      # long random secret shared by api and engine, e.g. `openssl rand -hex 32`

# --- LLM (OpenAI-compatible; design D1, E11) ---
QM_LLM_PROVIDER=cerebras  # cerebras | groq | ollama
QM_LLM_MODEL=gpt-oss-120b # comparison: qwen-3.8-27b; groq: openai/gpt-oss-120b; ollama: qwen2.5-coder:7b
QM_LLM_BASE_URL=          # empty = provider default
QM_CEREBRAS_API_KEY=      # cloud.cerebras.ai (free tier)
QM_GROQ_API_KEY=          # console.groq.com (free tier)
QM_LLM_REASONING_EFFORT=low  # low | medium | high (cerebras/groq)
QM_LLM_MAX_TOKENS=4096
QM_LLM_MIN_INTERVAL_S=    # empty = provider default (cerebras 12, groq 2, ollama 0)
QM_LLM_TIMEOUT_S=60
QM_OLLAMA_BASE_URL=http://localhost:11434/v1  # local dev only (design E10)
QM_LLM_NUM_CTX=8192       # ollama only

# --- Embeddings ---
QM_EMBED_BASE_URL=http://localhost:11434/v1
QM_EMBED_MODEL=nomic-embed-text
ENGINE_CACHE_DIR=.engine_cache  # embedding cache (design 5.3); gitignored

# --- Pipeline flags (design §6.6) ---
QM_DIALECT=postgres       # postgres | sqlite
QM_LINKING_MODE=auto      # auto | on | off
QM_LINKING_TOKEN_THRESHOLD=2000
QM_LINKING_TOP_K=5
QM_FEW_SHOT_ENABLED=true
QM_FEW_SHOT_K=3
QM_FEW_SHOT_POOL=fewshot/northwind.yaml
QM_SELF_CORRECTION_ENABLED=true
QM_MAX_CORRECTIONS=2
QM_ROW_LIMIT=1000
QM_STATEMENT_TIMEOUT_MS=10000
QM_UNANSWERABLE_ENABLED=true
QM_SUMMARY_ENABLED=true
QM_INCLUDE_DATE=true
